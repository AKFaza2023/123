<Application x:Class="STAVCMS.LocalServer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#111827" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="Panel2Brush" Color="#273449" />
        <SolidColorBrush x:Key="TextBrush" Color="#F9FAFB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9CA3AF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#22C55E" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
