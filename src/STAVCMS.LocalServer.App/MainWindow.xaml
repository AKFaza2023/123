<Window x:Class="STAVCMS.LocalServer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="STAVCMS Studio — Локальный сервер" Height="820" Width="1320" MinHeight="720" MinWidth="1100" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#0B1220" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="STAVCMS Studio" FontSize="22" FontWeight="Bold" Margin="0,4,0,24"/><TextBlock Text="Главная" Margin="0,8"/><TextBlock Text="Проекты" Margin="0,8" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/><TextBlock Text="Локальный сервер" Margin="0,8"/><TextBlock Text="Базы данных" Margin="0,8" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Расширения" Margin="0,8" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Резервные копии" Margin="0,8" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Настройки" Margin="0,8" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="STAVCMS Local Server 0.7" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="RootPathText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
<Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Проекты" FontSize="28" FontWeight="Bold"/><TextBlock Text="Управление локальными STAVCMS и PHP-проектами" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="StartButton" Content="Запустить сервер" Click="StartButton_Click" Background="{StaticResource AccentBrush}" Foreground="White"/><Button x:Name="RestartButton" Content="Перезапустить" Click="RestartButton_Click"/><Button x:Name="StopButton" Content="Остановить" Click="StopButton_Click"/></StackPanel></Grid>
<UniformGrid Columns="3" Margin="0,0,0,18"><Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="Apache" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ApacheStatusText" Text="Остановлен" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="MariaDB" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MariaDbStatusText" Text="Остановлена" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="Инструменты" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="PHP 8.4 + phpMyAdmin 5.2.3" FontSize="20" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
<Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Мои проекты" FontSize="18" FontWeight="Bold"/><Button Grid.Column="1" Content="Обновить" Click="RefreshButton_Click"/></Grid><ListBox x:Name="ProjectsList" Margin="0,12,0,10" Height="200" DisplayMemberPath="Name" SelectionChanged="ProjectsList_SelectionChanged"/><WrapPanel><Button Content="Открыть сайт" Click="OpenSite_Click"/><Button Content="Админка STAVCMS" Click="OpenAdmin_Click"/><Button Content="База данных" Click="OpenDatabase_Click"/><Button Content="Папка" Click="OpenFolder_Click"/><Button Content="Логи" Click="OpenLogs_Click"/><Button Content="Настройки" Click="OpenSettings_Click"/><Button Content="Архивировать" Click="ArchiveProject_Click"/><Button Content="Удалить" Click="RemoveProject_Click"/></WrapPanel><TextBlock x:Name="SelectedProjectText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="Новый проект" FontSize="18" FontWeight="Bold"/><TextBlock Text="Название" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4"/><TextBox x:Name="ProjectNameBox" Text="Новый STAVCMS"/><TextBlock Text="Локальный домен" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/><TextBox x:Name="ProjectDomainBox" Text="project.local"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="PHP" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="PhpBox" SelectedIndex="0"><ComboBoxItem Content="8.4"/><ComboBoxItem Content="8.3"/><ComboBoxItem Content="8.2"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Тип" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="ProjectTypeBox" SelectedIndex="0"><ComboBoxItem Content="STAVCMS" Tag="stavcms"/><ComboBoxItem Content="PHP-проект" Tag="php"/></ComboBox></StackPanel></Grid><CheckBox x:Name="HttpsBox" Content="Включить локальный HTTPS" Margin="0,12,0,10"/><WrapPanel><Button Content="Создать проект" Click="CreateProject_Click" Background="{StaticResource AccentBrush}" Foreground="White"/><Button Content="Импортировать папку" Click="ImportProject_Click"/></WrapPanel></StackPanel></Border></Grid>
<Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,18"><StackPanel><TextBlock Text="Проверка среды" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="ApachePathText" Margin="0,8,0,2"/><TextBlock x:Name="MariaDbPathText" Margin="0,2"/><TextBlock x:Name="PortStatusText" Margin="0,2"/></StackPanel></Border>
<Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="Журнал" FontSize="18" FontWeight="Bold"/><TextBox x:Name="LogBox" Margin="0,10,0,0" Height="150" IsReadOnly="True" Background="#111827" Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
</StackPanel></ScrollViewer></Grid></Window>